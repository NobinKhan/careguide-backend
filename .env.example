PORT=3000
# Docker deploy only: public hostname for the API (Caddy gets the HTTPS certificate for it)
API_DOMAIN=api.careguide.psucaonline.com
MONGODB_URI=mongodb://127.0.0.1:27017/careguide
JWT_SECRET=replace-with-secure-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Seed credentials (required by `bun run seed`; no defaults, min 8 characters)
SEED_ADMIN_EMAIL=admin@careguide.bd
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
